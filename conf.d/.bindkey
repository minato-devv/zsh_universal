bindkey -N mymap .safe # Create a new keymap based on the .safe keymap
bindkey -A mymap main # Alias mymap to main to set as active keymap

b=(bindkey -M mymap) # Array variable for easier binding

$b '^[[C' forward-char
$b '^[[D' backward-char
$b '^?' backward-delete-char
$b '^[[A' up-line-or-history
$b '^[[B' down-line-or-history
$b '^V' quoted-insert
$b '^P' describe-key-briefly
$b '^I' complete-word
$b '^[[200~' bracketed-paste

$b '^Xa' _expand_alias
$b '^Xw' expand-word
$b '^X*' '^Xa^Xw'

$b '^L' forward-char
$b '^H' backward-char
$b '^K' up-line-or-history
$b '^J' down-line-or-history

$b '^A' beginning-of-line
$b '^E' end-of-line

$b '^X' kill-whole-line
$b '^R' history-incremental-search-backward
# $b '^[' clear-screen
